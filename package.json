{
  "name": "talk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Talk: a voice-first agent service on pi and Pi Durable, with a page built on @jaetask/toolkit, apps over MCP and an ask-before-delete gate",
  "author": "jaetask",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaetask/talk.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "npm run build:page && tsx src/server.ts",
    "build": "npm run build:page",
    "build:page": "node scripts/build-page.mjs",
    "typecheck": "tsc --noEmit && tsc -p page --noEmit && node .agents/guardrails/check-comments.mjs",
    "test": "tsx test/run.ts && tsx packages/pi-voice/test/run.ts",
    "test:update": "tsx test/run.ts --update && tsx packages/pi-voice/test/run.ts --update",
    "lint": "biome lint . && npm run check:docs && npm run check:toolkit",
    "check:toolkit": "toolkit-guard page",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "git config core.hooksPath .agents/guardrails/hooks || true",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "tsx": "4.20.5",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@jaetask/snap": "0.1.0",
    "@jaetask/toolkit": "0.3.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "zustand": "5.1.0"
  }
}
