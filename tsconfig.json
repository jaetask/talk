{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "test", "packages", "scripts"],
  "exclude": ["node_modules", "packages/*/node_modules"]
}
