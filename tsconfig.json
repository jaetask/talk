{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "types": ["bun"], "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "test", "packages"]
}
